<XML ID = "EQInterfaceDefinitionLanguage">
	<Schema xmlns = "EverQuestData" xmlns:dt = "EverQuestDataTypes"/>
	<!-- -->
	<Button item = "HB_Button[calc i + 1]">
		<ScreenID>HB_Button[calc i + 1]</ScreenID>
		<Font>1</Font>
		<Location>
			<X>[calc i * 40]</X>
			<Y>10</Y>
		</Location>
		<Size>
			<CX>40</CX>
			<CY>40</CY>
		</Size>
		<DecalSize>
			<CX>40</CX>
			<CY>40</CY>
		</DecalSize>
		<TextColor>
			<R>255</R>
			<G>255</G>
			<B>255</B>
		</TextColor>
		<ButtonDrawTemplate>
			<Normal>A_HotButton[calc i + 1]Normal</Normal>
			<Pressed>A_HotButton[calc i + 1]Pressed</Pressed>
			<Flyby>A_HotButton[calc i + 1]Flyby</Flyby>
			<Disabled>A_HotButton[calc i + 1]Disabled</Disabled>
			<PressedFlyby>A_HotButton[calc i + 1]PressedFlyby</PressedFlyby>
		</ButtonDrawTemplate>
	</Button>
	<!-- -->
	<InvSlot item = "HB_InvSlot[calc i + 1]">
		<Background>A_RecessedBox</Background>
		<ScreenID>HB_InvSlot[calc i + 1]</ScreenID>
		<EQType>-1</EQType>
		<Location>
			<X>[calc i * 40]</X>
			<Y>10</Y>
		</Location>
		<Size>
			<CX>40</CX>
			<CY>40</CY>
		</Size>
	</InvSlot>
	<!-- -->
	<SpellGem item = "HB_SpellGem[calc i + 1]">
		<ScreenID>HB_SpellGem[calc i + 1]</ScreenID>
		<SpellIconOffsetX>8</SpellIconOffsetX>
		<SpellIconOffsetY>4</SpellIconOffsetY>
		<Location>
			<X>[calc i * 40]</X>
			<Y>15</Y>
		</Location>
		<Size>
			<CX>40</CX>
			<CY>32</CY>
		</Size>
		<SpellGemDrawTemplate>
			<Holder>A_SpellGemHolder</Holder>
			<Background>A_SpellGemBackground</Background>
			<Highlight>A_SpellGemHighlight</Highlight>
		</SpellGemDrawTemplate>
	</SpellGem>
	<!-- -->
</XML>