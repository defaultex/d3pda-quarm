    <!-- -->
	<StaticAnimation item="GW_IWnd_GaugeHolder[i]">
		<Animation>D3PDA_IWnd_GaugeHolder</Animation>
		<Style_Transparent>true</Style_Transparent>
		<Location>
			<X>18</X>
			<Y>[calc i * 30]</Y>
		</Location>
		<Size>
			<CX>32</CX>
			<CY>30</CY>
		</Size>
	</StaticAnimation>
