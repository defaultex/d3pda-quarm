    Target = EQUI_GroupWindow.xml
)

Copy(
    Regexp = <Screen item="GW_Group[i]_Name_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_GroupWindow.xml
)

Copy(
    Regexp = <Screen item="GW_Group[i]_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_GroupWindow.xml
)