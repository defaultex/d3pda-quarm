<!--# Template file for the code gen in '.generator' #-->
<?xml version="1.0"?>
<XML ID="EQInterfaceDefinitionLanguage">
    <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes"/>
    <!-- -->
    <InvSlot item="MW_MerchantSlot[i]">
        <ScreenID>MW_MerchantSlot[i]</ScreenID>
        <EQType>[calc i + 6000]</EQType>
        <Background>A_RecessedBox</Background>
        <ItemOffsetX>2</ItemOffsetX>
        <ItemOffsetY>2</ItemOffsetY>
        <Location>
            <X>[calc (i % 2) * 35]</X>
            <Y>[calc Math.Floor(i / 2) * 35]</Y>
        </Location>
        <Size>
            <CX>35</CX>
            <CY>35</CY>
        </Size>
    </InvSlot> 
    <!-- --> 
</XML>