# Configuration file for the code gen in '.generator'

TemplateFilename = buff_window_r/Buff.xmltemplate
OutputFormat = buff_window_r/Buff[i].xml
StartIndex = 0
Count = 15

CopyElement(
    Element = Screen:BW_Buff[i]_Label_Layout
    Destination = EQUI_BuffWindow_r.xml
)
CopyElement(
    Element = Screen:BW_Buff[i]_Layout
    Destination = EQUI_BuffWindow_r.xml
)