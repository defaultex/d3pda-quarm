    <SpellGem item="CSPW_Spell[i]">
        <ScreenID>CSPW_Spell[i]</ScreenID>
        <SpellIconOffsetX>2</SpellIconOffsetX>
        <SpellIconOffsetY>2</SpellIconOffsetY>
        <SpellIconSizeX>18</SpellIconSizeX>
        <SpellIconSizeY>18</SpellIconSizeY>
        <Location>
            <X>18</X>
            <Y>[calc i * 30]</Y>
        </Location>
        <Size>
            <CX>179</CX>
            <CY>30</CY>
        </Size>
        <SpellGemDrawTemplate>
            <Holder>D3PDA_IWnd_GemHolder</Holder>
            <Background>D3PDA_IWnd_GemBackground</Background>
        </SpellGemDrawTemplate>
    </SpellGem>
    <Gauge item="CSPW_Spell[i]Recast">
		<ScreenID>CSPW_Spell[i]Recast</ScreenID>
        <EQType>[EQGaugeType.Spell[i]Recast]</EQType>
        <TextOffsetY>-250</TextOffsetY>
        <GaugeOffsetY>0</GaugeOffsetY>
        <Location>
            <X>42</X>
            <Y>[calc i * 30]</Y>
        </Location>
        <Size>
            <CX>155</CX>
            <CY>30</CY>
        </Size>
        <FillTint>
            <R>75</R>
            <G>101</G>
            <B>100</B>
        </FillTint>
        <GaugeDrawTemplate>
            <Fill>D3PDA_Gauge_CastFill</Fill>
        </GaugeDrawTemplate>
        <DrawLinesFill>false</DrawLinesFill>
    </Gauge>
