<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
    <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />
    <!-- -->
    <Label item="[Name]">
        <Font>[FontSize]</Font>
        <EQType>[EQType]</EQType>
        <!-- -->
        <Location>
            <X>[calc X + 1]</X>
            <Y>[calc Y + 1]</Y>
        </Location>
        <Size>
            <CX>[Width]</CX>
            <CY>[Height]</CY>
        </Size>
        <!-- -->
        <TextColor>
            <R>[ColorR]</R>
            <G>[ColorG]</G>
            <B>[ColorB]</B>
        </TextColor>
    </Label>
    <Label item="[Name_OutlineTL">
        <Font>[FontSize]</Font>
        <EQType>[EQType]</EQType>
