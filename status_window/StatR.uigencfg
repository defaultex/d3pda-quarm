TemplateFilename = status_window/StatR.xmltemplate
OutputFormat = status_window/[Stat].xml
StartIndex = 0
Count = 7

Param(
    Key = Stat
    Value = AC, AT, MR, FR, CR, PR, DR
)

Copy(
    Regexp = <\s*Screen\s*item=\s*"SW_[Stat]Label_Layout"\s*>(?:.|\n)*?</Screen\s*>
    Target = EQUI_PlayerWindow.xml
)