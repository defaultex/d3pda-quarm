TemplateFilename = StatGauge.xmltemplate
OutputFormat = [Enum].xml
Enum = XP, AA

Copy(
    Regexp = <Screen item="SW_[Enum]Label_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <Screen item="SW_[Enum]Value_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <Screen item="SW_[Enum]PerHourValue_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <Screen item="SW_[Enum]_Layout">(?:.|\n)*?</Screen>
    Target = EQUI_PlayerWindow.xml
)
