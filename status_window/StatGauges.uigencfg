# Configuration file for the code gen in '.generator'

TemplateFilename = status_window/StatGauge.xmltemplate
OutputFormat = status_window/[Stat].xml
StartIndex = 0
Count = 2

Param(
    Stat = XP, AA
)

CopyElement(
    Element = Screen:SW_[Stat]Label_Layout
    Destination = EQUI_PlayerWindow.xml
)
CopyElement(
    Element = Screen:SW_[Stat]Value_Layout
    Destination = EQUI_PlayerWindow.xml
)
CopyElement(
    Element = Screen:SW_[Stat]PerHourValue_Layout
    Destination = EQUI_PlayerWindow.xml
)
CopyElement(
    Element = Screen:SW_[Stat]_Layout
    Destination = EQUI_PlayerWindow.xml
)