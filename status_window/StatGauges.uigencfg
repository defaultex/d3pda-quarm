TemplateFilename = status_window/StatGauge.xmltemplate
OutputFormat = status_window/[Stat].xml
StartIndex = 0
Count = 2

Param(
    Key = Stat
    Value = XP, AA
)

Copy(
    Regexp = <\s*Screen\s*item=\s*"SW_[Stat]Label_Layout"\s*>(?:.|\n)*?</Screen\s*>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <\s*Screen\s*item=\s*"SW_[Stat]Value_Layout"\s*>(?:.|\n)*?</Screen\s*>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <\s*Screen\s*item=\s*"SW_[Stat]PerHourValue_Layout"\s*>(?:.|\n)*?</Screen\s*>
    Target = EQUI_PlayerWindow.xml
)

Copy(
    Regexp = <\s*Screen\s*item=\s*"SW_[Stat]_Layout"\s*>(?:.|\n)*?</Screen\s*>
    Target = EQUI_PlayerWindow.xml
)
