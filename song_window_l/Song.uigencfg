# Configuration file for the code gen in '.generator'

TemplateFilename = song_window_l/Song.xmltemplate
OutputFormat = song_window_l/Song[i].xml
StartIndex = 0
Count = 5

CopyElement(
    Element = Screen:SDBW_Buff[i]_Label_Layout
    Destination = EQUI_SongWindow_l.xml
)
CopyElement(
    Element = Screen:SDBW_Buff[i]_Layout
    Destination = EQUI_SongWindow_l.xml
)
